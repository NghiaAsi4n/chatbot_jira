# One sandbox account. Never commit .env.
# Auth mode: oauth | basic | bearer
# basic  = email + API token (most common for personal sandbox)
# bearer = API key only (requires org-level MCP token auth enablement)
# oauth  = browser-based OAuth 2.1 (no token needed)
ATLASSIAN_AUTH_MODE=basic
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp?tools=all
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task
# Run: python -m chatbot_jira.smoke inspect  → copy the cloud ID here.
ATLASSIAN_CLOUD_ID=
# Site URL for building issue links (e.g. https://yoursite.atlassian.net)
ATLASSIAN_SITE_URL=
MCP_CALLBACK_PORT=8765

# --- Basic auth (ATLASSIAN_AUTH_MODE=basic) ---
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token
# Bearer auth (ATLASSIAN_AUTH_MODE=bearer, org must enable MCP token auth)
ATLASSIAN_API_KEY=

# --- LLM (Ollama Cloud / OpenAI-compatible) ---
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:31b
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
# Optional legacy aliases; LLM_* above take priority.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
LLM_TIMEOUT_SECONDS=60
